  workspace_id bigint [not null]
  contract_id bigint [not null]
  service_code varchar(64) [not null]
  external_tenant_id varchar(255)
  portal_url varchar(2048)
  status varchar(16) [not null, note: 'pending | provisioning | active | suspended | failed | revoked']
  provisioned_at timestamp
  revoked_at timestamp
  created_at timestamp
  updated_at timestamp
  indexes {
    (workspace_id, contract_id, service_code) [unique]
  }
  Note: '[DEFERRED] Methodology describes separate SaaS; web only nav/cards. Proposed handoff boundary, not a full project/task/payroll/attendance model.'
}

// [NEW] internal_notes
Table internal_notes [headercolor: #dcfce7] {
  id bigint [pk, increment]
  application_id bigint
  help_request_id bigint
  request_item_id bigint
  author_admin_id bigint [not null]
  body text [not null]
  edited_at timestamp
  deleted_at timestamp
  created_at timestamp
  updated_at timestamp
  indexes {
    (application_id, created_at)
    (help_request_id, created_at)
    (request_item_id, created_at)
  }
  Note: '[NEW] Applications/help requests/hiring operations. Exactly one target FK non-null. Internal-only; edited notes also produce audit events.'
}

// [NEW] workflow_events
Table workflow_events [headercolor: #dcfce7] {
  id bigint [pk, increment]
  aggregate_type varchar(64) [not null]
  aggregate_id bigint [not null]
  workspace_id bigint
  actor_user_id bigint
  actor_kind varchar(16) [not null, note: 'user | system']
  on_behalf_of_user_id bigint
  event_type varchar(100) [not null, note: 'status_changed, reviewer_assigned, reapply_changed, hold, resumed, rejected_on_behalf, decision_withdrawn, etc.']
  from_status varchar(32)
  to_status varchar(32)
  reason text
  changes json [note: 'Only allowlisted changed fields; no passwords/tokens/payment secrets']
  correlation_id uuid
  deduplication_key varchar(255) [unique]
  occurred_at timestamp [not null]
  indexes {
    (aggregate_type, aggregate_id, occurred_at)
    (workspace_id, occurred_at)
  }
  Note: '[NEW] Append-only business audit with actual actor and represented party. Polymorphic target is deliberate exception; target validation/retention in service. Existing api_key events are insufficient.'
}

// [NEW] notifications
Table notifications [headercolor: #dcfce7] {
  id bigint [pk, increment]
  user_id bigint [not null]
  workspace_id bigint
  workflow_event_id bigint
  type varchar(100) [not null]
  safe_payload json [not null]
  read_at timestamp
  deduplication_key varchar(255) [not null, unique]
  created_at timestamp
  updated_at timestamp
  indexes {
    (user_id, read_at, created_at)
  }
  Note: '[NEW] In-app bell and email delivery. Durable user notification; workflow event created in same transaction with recipient messages.'
}

// [NEW] notification_deliveries
Table notification_deliveries [headercolor: #dcfce7] {
  id bigint [pk, increment]
  notification_id bigint [not null]
  channel varchar(16) [not null, note: 'database | email']
  status varchar(16) [not null, default: 'pending', note: 'pending | processing | sent | failed']
  attempt_count smallint [not null, default: 0]
  next_attempt_at timestamp
  sent_at timestamp
  last_error text
  created_at timestamp
  updated_at timestamp
  indexes {
    (notification_id, channel) [unique]
    (status, next_attempt_at)
  }
  Note: '[NEW] After-commit dispatch/retry record; acts as durable outbox. Same notification may have in-app and email channels; no email sent by schema task.'
}

// [PROPOSED] workflow_policy_versions
Table workflow_policy_versions [headercolor: #f3e8ff] {
  id bigint [pk, increment]
  key varchar(100) [not null]
  version_number int [not null]
  value json [not null]
  effective_at timestamp [not null]
  created_by_admin_id bigint [not null]
  created_at timestamp
  updated_at timestamp
  indexes {
    (key, version_number) [unique]
