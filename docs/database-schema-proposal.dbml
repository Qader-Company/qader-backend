// [CHANGE] talents
Table talents [headercolor: #fef3c7] {
  id bigint [pk, increment]
  user_id bigint [not null, unique]
  profile_completion_percentage tinyint [not null, default: 0]
  onboarding_step varchar(255) [not null, default: 'personal-information']
  profile_completion_details json
  profile_completion_updated_at timestamp
  professional_summary text
  whatsapp_country_code varchar(5)
  whatsapp_number varchar(20)
  phone_country_code varchar(5)
  phone_number varchar(20)
  date_of_birth date
  gender varchar(255)
  religion varchar(50)
  nationality_country_id bigint
  residence_country_id bigint
  residence_city_id bigint
  professional_field_id bigint
  willing_to_relocate boolean
  job_title_id bigint
  seniority_level varchar(255)
  years_of_experience smallint
  linkedin_url varchar(255)
  github_url varchar(255)
  behance_url varchar(255)
  portfolio_url varchar(255)
  onboarding_completed_at timestamp
  notice_period_days smallint
  current_salary decimal(12,2)
  current_currency_id bigint
  expected_salary_min decimal(12,2)
  expected_salary_max decimal(12,2)
  expected_currency_id bigint
  public_code varchar(32) [unique, note: 'ADD: QDR display ID, backfill then NOT NULL']
  availability_status varchar(32) [not null, default: 'unavailable', note: 'ADD: available | notice_period | unavailable; independent from approval']
  availability_updated_at timestamp [note: 'ADD']
  created_at timestamp
  updated_at timestamp
  indexes {
    profile_completion_percentage
    (job_title_id, seniority_level, years_of_experience)
    (availability_status, professional_field_id)
  }
  Note: '[CHANGE] Existing profile plus explicitly marked additions. No application status here. Legacy salary precision unchanged until D12 is approved.'
}

