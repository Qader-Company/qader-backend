// QADER WEB - DATABASE SCHEMA PROPOSAL / مسودة للمراجعة فقط
// Prepared: 2026-10-13, Africa/Cairo. Approval status: NOT APPROVED.
// Deliverable: one DBML file. No new/edited migrations, no DB writes, no code changes.
// DBML describes the PROPOSED TARGET, not an SQL script and not the deployed database.
// يمكن مراجعة الملف كنص أو رسمه بأداة تدعم DBML. لم يتم رفعه لأي خدمة خارجية.
//
// ============================================================================
// 01. فهم المشروع ونطاق المراجعة
// ============================================================================
// قادر وسيط تشغيلي للتوظيف: المرشح يقدم ملفه؛ فريق قادر يراجع ويقابل ويقيّم؛
// المقبول والمتاح يظهر في marketplace؛ العميل يجمع مرشحين في squad داخل workspace؛
// كل مرشح له offer/counteroffers ومقابلة وقرارات مستقلة؛ بعدها رسوم وعقود وتوظيف.
// Managed: علاقة مستمرة ورسوم إدارة. One-time: placement برسوم مرة واحدة، والراتب
// يدفعه العميل مباشرة حسب شاشة Build Your Team، فلا يضاف كله لمستحقات قادر.
// يوجد كذلك توظيف عام من public job postings مع form generator وguest submissions؛
// هذا مسار مختلف عن طلب الانضمام لشبكة المواهب ومختلف عن hiring request للعميل.
//
// ترتيب المرجعية: تصميم Qader web الحالي > وثائق الفلو المتخصصة > BRD/PRD/SRS.
// الكود والمigrations يحددان الموجود فعلاً في المستودع، وليس سلوك المنتج النهائي.
// تم قراءة نصوص كل العناصر الرئيسية داخل الأقسام الثلاثة: talent=63, admin=134,
// client=60 (257 top-level nodes، تشمل فريمات أرقام/عناوين؛ ليست 257 شاشة مستقلة).
// تم فحص صور 4 شاشات: squad, field generator, evaluation, payment confirmation.
// المستبعد: App، design system، DRAFFFTTTT، وقسم trash داخل Qader web.
// لم أفترض أن كل نص placeholder أو رابط بالـsidebar يعني feature مكتملة التصميم.
//
// Figma file: https://www.figma.com/design/Ey9gKqsJd8qx1aBMgefEQB/qader-app
// Web page: https://www.figma.com/design/Ey9gKqsJd8qx1aBMgefEQB/qader-app?node-id=629-4923
// Talent: https://www.figma.com/design/Ey9gKqsJd8qx1aBMgefEQB/qader-app?node-id=3802-39310
// Admin: https://www.figma.com/design/Ey9gKqsJd8qx1aBMgefEQB/qader-app?node-id=3802-39311
// Client: https://www.figma.com/design/Ey9gKqsJd8qx1aBMgefEQB/qader-app?node-id=3802-39313
//
// Supporting business sources (relative to this file):
// - BRD-V1.pdf: business/revenue/scope/process.
// - PRD-V1.pdf: modules 3.1-3.8 and individual interview preference per talent.
// - SRS-V1.pdf: FR-1..FR-9, privacy, contracts, billing, audit.
// - Qader_Flow_01_Talent_Application_Approval.pdf: states, FX, premium services.
// - Qader_Admin_Portal_Talent_Applications_Flow_Specification.pdf: sections 6-22,
//   scheduling/session separation, rejection/reapply/visibility/audit policies.
// - Methodology_Portals_Modules.pdf: especially 3.3 and 4, separate SaaS handoff.
// Supporting repo: architecture/01,03,04,06,07,08,09,10,11,12,13;
// ../database/migrations/*.php; TalentApplications/Talents/Clients/Admins/
// AccessControl/ProfessionalFields models, use cases, enum registry and seeders.
//
// ============================================================================
// 02. كيفية قراءة الملف / الموجود مقابل المقترح
// ============================================================================
// [KEEP]      جدول موجود، منقول بحالته المنطقية النهائية من migrations.
// [CHANGE]    جدول موجود؛ الإضافات/التعديلات موضحة في Note أو تعليقات الحقول.
// [NEW]       جدول جديد مقترح لتدفق مؤكد في Figma؛ تفاصيل التخزين نفسها اقتراح هندسي.
// [PROPOSED]  supporting design يحتاج اعتماد تفصيل/سياسة، وليس متطلباً محسومًا.
// [DOC]       مطلوب في وثائق البيزنس ولم تثبت تفاصيله في الويب الحالي.
// [DEFERRED]  حد تكامل لاحق؛ لا يبدأ تنفيذه ضمن أول دفعة migrations.
// جميع الحالات، حتى NEW، تنتظر مراجعتك؛ الملف ليس تصريح تنفيذ.
//
// Baseline: 48 tables declared by 21 checked-in migration files.
// لا يدعي هذا أن الـ48 جدول موجودة في قاعدة البيئة أو أن كل migration اتنفذت.
// لم يتم الاتصال بقاعدة البيانات؛ DB engine/deployed migration status غير متحققين.
// الملف يشمل migrations بتاريخ 2026_10_25 رغم أنها بعد تاريخ المراجعة؛ المصدر
// هو الملفات الموجودة، وليس ترتيب تاريخ النشر أو افتراض أنها pending/deployed.
// Types are logical DBML types: bigint/int represent the Laravel unsigned IDs
// where applicable. Engine-specific unsigned/check/partial-index DDL comes later.
// Unmarked fields on KEEP tables already exist. All fields on new tables are new.
// Nullable timestamps mirror Laravel timestamps; new writes must populate them.
// Indexes on CHANGE tables describe the target (including proposed additions).
//
// Existing coverage:
// Identity: users/clients/admins/social_accounts + Sanctum/API key infrastructure.
// RBAC: permissions/roles/3 Spatie pivots, portal-scoped but NOT workspace-scoped.
// Talent: profile, languages/skills/tools, experiences/projects, work types/modes.
// Lookups: countries/cities/languages/currencies + translations; fields + mapping.
// Media: existing Spatie media, onboarding form registry + field configuration.
// Applications: only id,talent_id UNIQUE,status default submitted,submitted_at,
// created_at,updated_at. No reviewer, interview, evaluation, decision or history.
// Clients/admins currently only id,user_id UNIQUE,timestamps; no company tables.
// No existing business requests/offers/contracts/payments/workspaces/job forms.
// Dependency gap: OtpService reads/deletes otps through ichtrojan/laravel-otp,
// but none of the 21 repo migrations declares otps, and vendor is unavailable here.
// Verify the package migration/deployment before auth work; do not mistake the
// inventory of repo migrations for the complete live schema or invent OTP columns.
//
// ============================================================================
// 03. قرارات السكيما المطلوب مراجعتها (defaults proposed, not silently approved)
// ============================================================================
// D01 - إعادة التقديم: Figma 802:4409 و3020:16356 تدعمان reapply، لكن الحالي
// UNIQUE(talent_id) + firstOrCreate(talent_id) يمنع التاريخ. المقترح 1:N attempts،
// UNIQUE(talent_id,attempt_number)، وactive_guard يمنع أكثر من محاولة نشطة.
// التقديم للمقبول لا ينشئ محاولة جديدة تلقائياً. Reopen امتياز مستقل مع audit.
// Existing talent FK changes CASCADE -> RESTRICT to retain application history.
//
// D02 - نسخة التقديم وقفل الملف: architecture/12 تقول snapshot لكن migration
// 2026_09_06_000000 تحذف profile_snapshot والكود الحالي لا يحفظ أي نسخة.
// المقترح submission_snapshot جديد بإصدار + تاريخ التقاط ومصدر واضحين؛ ليس ادعاء
// أن الحقل موجود. Figma 757:11694 تمنع تعديل الملف أثناء المراجعة، خلاف وثائق
// أقدم تسمح بالتعديل. المقترح قفل حقول التقديم أثناء UNDER_REVIEW وما بعده حتى
// القرار؛ الكتابة لا تغير snapshot أبدًا. تعديل بعد القبول لا يغير المنشور تلقائيًا.
// snapshot للطلبات القديمة: لا نخترع حالة تاريخية؛ أصل legacy_capture معلوم.
// كذلك architecture/04 و06 تسمحان بالتقديم غير المكتمل، بينما الكود الحالي ينشئ
// الطلب عند حفظ work-preferences وبعد اكتمال required_steps. المقترح الحفاظ على
// شرط الحقول المطلوبة المعتمدة من Figma مع السماح بنقص الاختياري، وتوثيق معنى
// completion بدقة؛ لا نضيف submit endpoint ولا نغير الحقول المطلوبة في هذه المهمة.
// توزيع الحقول الحالي يضع CV في work-preferences وsummary في personal-information،
// بينما Figma تعرض CV في Basic Info وsummary في Skills؛ هذه مواءمة API لاحقة،
// لا تحتاج جداول جديدة أو تكرار أعمدة.
//
// D03 - المقابلات المتعددة: PDF تقول second interview خارج V1، لكن Figma
// 881:10802 و1045:17994 تعرض Round1/Round2 وتسمح Schedule Interview بعد التقييم.
// Figma هي الأساس: ندعم rounds متعددة، مع فصل round عن محاولات إعادة الجدولة.
// لا نحول INTERVIEW_IN_PROGRESS إلى application status؛ هي session status فقط.
//
// D04 - حدود الحالات: acceptance=accepted في المقترح؛ بعض docs تستخدم approved.
// لا نغير البيانات مباشرة؛ نفحص القيم الفعلية ونحول aliases في backfill لاحقًا.
// users.is_active للحساب؛ talents.availability_status للتوفر؛ marketplace.visibility
// للظهور؛ talent_applications.status لقرار الطلب. لا نحشرها في status واحد.
// blacklist منفصل على مستوى talent؛ قائمة Rejected تضم المحظورين، لكن فك الحظر
// لا يلغي سبب رفض قديم ولا يمنح قبولًا. الهويات غير النشطة لا تظهر بالmarketplace.
//
// D05 - quotas/deadlines: Figma تمنح المرشح cancellation/reschedule واحدة، بينما
// PDF تقترح محاولتي scheduling. هذان عدادان مختلفان. نحفظ actor وسبب كل attempt.
// admin cancellation لا يستهلك quota المرشح. مهلة offer=48h وdecision=1 day
// مستمدة من نسخ UI، تحتاج اعتماد policy. Overdue يعني متابعة يدوية، لا رفض تلقائي.
// Figma 3670:34090/4292:111785 توضح warning عند إغلاق admin بسبب عدم الرد؛
// لذلك talent_account_warnings تحتفظ بكل warning ومصدره وإلغائه. عدد الفرص
// وسياسة suspension/expiry غير محسومة؛ لا نخلط warning أو suspension مع blacklist.
//
// D06 - اختيار الموعد: application يختار فيه talent موعدًا من slots. في hiring
// يوجد client+talent واختيار أوقات للطرفين؛ ترتيب أولوية/تقاطع الاختيارات غير مكتمل.
// المقترح slot_responses ثم تأكيد مشترك transaction؛ لا يتم تأكيد موعد بمجرد
// إنشاء slots يدويًا أو اعتماد reschedule request. بيانات الاقتراح الزمني optional لأن
// admin screen تعرضها بينما نموذج talent الحالي لا يطلبها.
//
// D07 - الرسوم: contract types fixed/percentage/both + override لكل professional
// field واضحة. أساس النسبة (شهري/سنوي/إجمالي)، الضريبة والتقريب غير محسومة.
// نحفظ fee rules version وsnapshot على الفاتورة والعقد. Fixed rule currency required؛
// percentage basis required عند وجود نسبة. لا نستخدم نسب/مبالغ demo كـdefaults.
// Payment screen 4362:57196 تعرض salary subtotal=30,200 وtransfer=3,600 مع رسوم
// غير محددة. لا يمكن اشتقاق إجمالي صحيح منها. total_due=NULL حتى تأكيد الرسوم.
// تأكيد الرواتب ورفع receipt والتحقق من التحويل ثلاث عمليات مختلفة.
//
// D08 - التقييم: Figma أربع criteria 1..5، والـPDF weights/criteria مختلفة.
// لا نزرع الستة أو نفسر badge 35% كوزن مؤكد. الوزن configurable+snapshot؛
// الصيغة المقترحة sum(rating/5*weight) عندما sum(weight)=100.
// Annual Salary في report مقابل monthly في offers: salary_period صريح.
// ranking يحتاج cohort/time/method، فلا نخزن Top15% كحقيقة دون أساس أو كـdefault.
//
// D09 - الحذف: Figma delete client تقول حذف دائم يشمل العقود والتاريخ.
// اقتراح يحتاج اعتماد مخالف لهذا النص: أرشفة الهوية/workspace مع الاحتفاظ
// بتاريخ العقود والمدفوعات/audit. حذف draft child فقط يسمح cascade؛ السجلات
// المالية والتشغيلية restrict. لا تنفذ أي حذف أو retention policy قبل حسم القرار.
// كذلك delete form مع submissions تقترح أرشفة للحفاظ على إجابات تاريخية.
//
// D10 - الخدمات المدفوعة: talent feedback/early reapply وclient opinion منفصلة
// عن access subscription. المقترح شراء client يكون للworkspace عن talent محدد؛
// يلزم اعتماد هل الشراء لكل client أو workspace، ولكل report version أم lifetime.
// عرض فوري للclient opinion المنشور، أما طلب profile review قد ينتظر تنفيذ خبير.
// سعر 100EGP/250EGP/$10 وضمان14 يوم أمثلة/نصوص تحتاج سياسة معتمدة.
// early reapply بعد تحقق الدفع يغير الأهلية مع audit؛ لا يتجاوز blacklist.
// Internal decision reason والتقرير المنشور ورسالة المرشح حقول منفصلة.
//
// D11 - access subscription من BRD/SRS: لا شاشة شراء/تجديد واضحة في الأقسام
// الحالية. DOC tables فقط مع اقتراح workspace scope، لا نفترض gate مطبق بالفعل.
// SRS تخفي الاسم/الصورة/CV قبل التعاقد، وبعض صور marketplace placeholders تحمل
// وجوهاً؛ شاشة3649:29356 تقول personal/contact available after contracting.
// نعتمد إخفاء الهوية/الاتصال حتى executed contract إلى أن تعتمد disclosure matrix.
// شراء expert opinion لا يمنح CV/phone/email/contact access.
//
// D12 - العملات: الحالي decimal(12,2)، المقترح الجديد decimal(18,4)؛ اعتماد توحيد
// precision مطلوب لدعم عملات 3 decimals. تحويلات append-only وبنفس base currency.
// الأصل لا يستبدل بقيمة محولة. quotes تحفظ المعدل المستعمل للعرض/الالتزام، وتحتاج
// سياسة retention للعرض فقط. لا يتم اختيار مزود FX أو معدل فعلي في هذه المسودة.
//
// D13 - Projects/Tasks/Attendance: Figma يعرض navigation/cards وبعض مزايا managed،
// دون شاشات تشغيل كافية. Methodology تقول SaaS مستقل؛ BRD/PRD تقول portal مدمجة.
// المقترح مؤقتاً service_provisions كحد تسليم فقط. لا توجد هنا جداول تشغيل مختلقة
// للمشروعات/التاسكات/الحضور/payroll؛ تصميم هذا الجزء وإقامة بياناته قرار منفصل.
//
// D14 - Jobs/Form generator مؤكد بالويب. لا نعيد استخدام Laravel jobs أو
// talent_applications أو professional_form_fields كأسئلة عشوائية. الأربع identity
// fields ثابتة؛ الأسئلة من catalog؛ submissions تربط بإصدار غير قابل للتغيير.
// Start Hiring Process بـ4414:76117 لا يوضح هل يعني vetting أم request للعميل؛
// المقترح تحويل اختياري موثق لtalent application بعد التحقق، وليس قبولًا تلقائيًا.
//
// D15 - workspace/candidate invitations وSave Job أزرار موجودة أو دعم منطقي
// لعضويات الفرق، لكن التفاصيل غير مكتملة. جداول PROPOSED تنتظر اعتماد السلوك.
// workspaces.owner_client_id 1:N؛ members M:N. client ≠ company ≠ workspace.
// Spatie teams=false الآن؛ workspace_roles منفصلة بدل منح عضو صلاحيات عالمية.
// Marketing يقول Request Access/Get Approved بينما إنشاء workspace الفعلي يقول
// now active. المقترح active حسب الفلو الفعلي؛ لا approval pipeline للشركات دون حسم.
//
// D16 - industry experience/main specialization ظاهرة في marketplace ولا توجد
// لها حقول onboarding واضحة. المقترح admin-curated ضمن approved projection.
// Skills & Proficiency عنوان فقط؛ لا نعيد proficiency/years/is_primary المحذوفة
// من talent_skills بناءً على عنوان دون مدخل واضح. Public content/FAQ static حاليًا؛
// لا CMS ولا matching AI ولا chat backend مستنتج من نصوص marketing.
//
// ============================================================================
// 04. State transitions and cross-table constraints (mandatory when implemented)
// ============================================================================
// C01 Tenant isolation:
// Every request/contract/invoice/member action checks active workspace membership.
// Member-role, invitation-role, created_by_member, request->contract->invoice lines
// must all refer to the same workspace. Explicit IDs do not replace tenant checks.
// Add composite FK constraints where engine supports suitable parent unique keys;
// enforce remaining cross-aggregate rules inside the owning transactional service.
// user.type must match its one-to-one client/admin/talent profile.
//
// C02 Applications:
// submitted -> under_review -> interview_required -> interview_scheduled ->
// waiting_result -> accepted/rejected; waiting_result -> interview_required for
// a NEW interview round; under_review may reject; authorized closure -> closed.
// Reschedule returns scheduled -> required; all-slots-rejected remains required.
// Terminal attempts are immutable except explicit audited reopen/reapply policy edits.
// active_guard=1 iff status is active, NULL iff terminal; CHECK plus unique pair.
// Transactions lock talent row to allocate next attempt_number and enforce eligibility.
// Reapply requires rejected/closed eligible previous attempt, reapply_at reached or
// settled early-reapply entitlement, active verified account and NO active blacklist.
// Migration must backfill active_guard according to status before enabling constraints.
//
// C03 Marketplace:
// accepted application + approved projection visibility=visible + eligible availability
// + active verified account + no current blacklist => eligible result. Whether
// notice_period counts as available is D04 policy; proposed yes with explicit notice.
// Changes to private live profile never bypass reviewer approval of public projection.
// Profile completion/platform-access permission is not talent approval. Existing
// TalentPlatformAccessService uses completion + application existence only.
// Gate marketplace/hiring separately; pending applicants retain their review dashboard.
//
// C04 Hiring:
// draft -> awaiting_response/negotiating -> interview_scheduling (if required)
// -> interview_scheduled -> awaiting_decisions -> accepted -> ready_for_contract
// -> contracted; no-interview route requires accepted offer before accepted.
// Reject/cancel are terminal; on_hold is resumable. Hold/cancel atomically cancel
// open slots, active interviews and pending offers/decision deadlines; keep history.
// Resume creates fresh activities/offer version; does not reactivate old cancelled rows.
// Exactly one current sent offer per item (transaction lock + engine-specific active
// uniqueness during implementation). Counteroffer supersedes current offer atomically.
// accepted_offer_id must reference this item and status accepted; parent_offer too.
// Post-interview continue requires two valid, current, opposite-party decisions.
// Replacement stays in same hiring request, different talent, no cycles; at most
// one immediate successor via unique replaces_item_id. Whole-request progress derives
// from current non-replaced items, excluding retired predecessors; do not double count.
// Parent completed when every current item terminal; all-cancelled parent=cancelled;
// mixed outcomes completed with per-item results; all-on-hold display is derived.
//
// C05 Scheduling:
// Exactly one interview context; interview round_number unique per context.
// Slot dates UTC, end>start, future on publication; display timezone IANA retained.
// Confirm within deadline, lock interview and interviewer calendar identities,
// check overlap against scheduled interviews, choose exactly one same-interview slot,
// set selected_slot_id and scheduling round selected, cancel other available slots.
// Reschedule/cancel frees booking but retains historical slot/participant rows.
// Multiple interviewers must all be free in every offered slot; lock admin rows in
// stable ID order before conflict checks and inserts to avoid double-booking races.
// All-slots rejection recorded on scheduling round with actor/reason (audit event).
// Pair decision belongs to hiring-context interview for the SAME request item.
// Timer/UI labels Ready/Join are computed from scheduled time; no extra tables.
//
// C06 Money/work terms:
// Amount and currency paired, nonnegative salary/fees, min<=max, percentage 0..100,
// FX rates >0; both rate rows share base currency and correspond to source/target.
// Decimal arithmetic only; round by configured currency exponent at invoice issuance.
// work_type full_time/part_time; work_mode remote/onsite/hybrid; schedule JSON schema:
// weekdays=[0..6] unique, timezone IANA, start_local/end_local OR daily_hours,
// hybrid_onsite_days subset of weekdays; location required for onsite/hybrid.
// At contract signing copy accepted offer + fee version into immutable terms_snapshot.
//
// C07 Media/data retention:
// Use existing media for talent.cv, talent_project.images (max5, 5MB), workspace.logo
// (5MB), workspace.tax_card, application submission_cv, form_answer.upload,
// payment.receipt (10MB), contract_document.file/signature evidence.
// Snapshot original submission CV as an application-owned immutable media copy;
// live talent CV collection is single-file and replacement currently deletes old CV.
// Validate MIME/size per collection; CV UI differs PDF/DOC vs DOCX, approve exact
// matrix before implementation. Tax card only required for is_company=true.
// Private downloads require authorization/signed URLs; polymorphic media has no
// physical owner FK so deletion and owner matching must be enforced by service.
// country/city combinations must match; don't infer age column from birthdate label.
//
// C08 Billing/access:
// NULL fees ≠ zero fees. total_due only after fee rule approval and line calculation.
// salary_reference line is informational; line included_in_total=false.
// Final invoices immutable, later correction via explicit adjustment/refund.
// Payment currency=invoice currency, cumulative verified payment <= agreed balance
// unless an explicit overpayment policy is approved. Receipt may be accepted for
// review during pending_fees but no paid state/entitlement until final amount agreed.
// Settled payment + published audience-appropriate report => entitlement once.
// Refresh/retry/webhook must use idempotency key; no duplicate grant or contract.
// Only fully executed required documents yield contracted disclosure/engagement.
// Subscription periods for same workspace/plan must not overlap accidentally.
//
// C09 Forms:
// Four identity fields always required. job title server-filled from published
// posting; do not trust hidden client field. Published versions immutable.
// form_field.version must equal submission.version, unique answer per question.
// Typed JSON validated against frozen type/rules/options; uploaded media owned by
// that submission/answer. No auto-merge/verification merely because email matches.
// Copy form copies field configuration to new draft, never submissions.
// Counts/CSV exports derived from submissions, subject to admin permission.
//
// C10 Audit/reliability:
// State/assignment/blacklist/reapply changes + workflow_event + notification outbox
// written atomically. Actual actor and on_behalf_of party always separate.
// Save old/new assignment IDs in event.changes for reviewer/reassignment history.
// No status-by-boolean, floating money, mutable signed terms, or sensitive raw audit dump.
// Internal_notes exactly one target; reports/orders/evaluations/applications/talent
// must agree on talent and application IDs. Refunds/withdrawal cannot silently grant access.
// Settings/rules/deadlines copied at action time so later changes aren't retroactive.
// No-response admin closure + warning + any approved suspension action are atomic;
// one warning per offer/category. Warning count is derived, not an unchecked counter.
//
// ============================================================================
// 05. ترتيب التنفيذ بعد مراجعتك فقط (لا تنفيذ في هذه المهمة)
// ============================================================================
// A. Audit real migration state/data, then application attempts + audit + blacklist
//    + interviews + evaluations + approved visibility. Preserve current onboarding.
// B. Clients/workspaces/membership authorization + help requests + marketplace.
// C. Contract configuration + draft squad/request items + offers/replacements/decisions.
// D. Invoice/receipt verification + contract documents/signatures + engagements.
// E. Public job postings/forms/submissions (independent delivery slice).
// F. Premium fulfillment/access + FX; subscriptions only after D11 resolved.
// G. Separate work-management SaaS after D13 decision; never infer attendance tables.
// Backfill strategy: new nullable columns first, inspect duplicates/statuses, capture
// legacy snapshots honestly, assign stable codes, populate guards, then add constraints.
// Do not edit historical migrations; create focused future migrations only after approval.
// No runtime tests or migrations are required for this documentation-only change.
//
// ============================================================================
// 06. خريطة الشاشات إلى مجموعات الجداول (مراجع مباشرة للمراجعة)
// ============================================================================
// Onboarding -> Talent/Reference/media:
// https://www.figma.com/design/Ey9gKqsJd8qx1aBMgefEQB/qader-app?node-id=671-9328
// https://www.figma.com/design/Ey9gKqsJd8qx1aBMgefEQB/qader-app?node-id=676-10812
// https://www.figma.com/design/Ey9gKqsJd8qx1aBMgefEQB/qader-app?node-id=676-11369
// Review/reviewer/history -> Applications/Evaluation/workflow_events:
// https://www.figma.com/design/Ey9gKqsJd8qx1aBMgefEQB/qader-app?node-id=848-10876
// https://www.figma.com/design/Ey9gKqsJd8qx1aBMgefEQB/qader-app?node-id=1078-10504
// https://www.figma.com/design/Ey9gKqsJd8qx1aBMgefEQB/qader-app?node-id=1030-9753
// Slots/rounds -> Interviews:
// https://www.figma.com/design/Ey9gKqsJd8qx1aBMgefEQB/qader-app?node-id=881-10802
// Workspace/company identity -> Workspace:
// https://www.figma.com/design/Ey9gKqsJd8qx1aBMgefEQB/qader-app?node-id=4287-55632
// Marketplace/paid opinion -> approved profiles + expert_reports + service_orders:
// https://www.figma.com/design/Ey9gKqsJd8qx1aBMgefEQB/qader-app?node-id=3260-24102
// https://www.figma.com/design/Ey9gKqsJd8qx1aBMgefEQB/qader-app?node-id=3260-27929
// Squad/mixed contract types -> Hiring + Commercial:
// https://www.figma.com/design/Ey9gKqsJd8qx1aBMgefEQB/qader-app?node-id=3730-38377
// https://www.figma.com/design/Ey9gKqsJd8qx1aBMgefEQB/qader-app?node-id=3916-42854
// Per-item journey/decisions -> Hiring + Interviews:
// https://www.figma.com/design/Ey9gKqsJd8qx1aBMgefEQB/qader-app?node-id=3290-38355
// https://www.figma.com/design/Ey9gKqsJd8qx1aBMgefEQB/qader-app?node-id=4032-56278
// No-response warnings -> talent_account_warnings:
// https://www.figma.com/design/Ey9gKqsJd8qx1aBMgefEQB/qader-app?node-id=3670-34090
// Payment/receipt -> invoices/lines/payments (not automatically paid):
// https://www.figma.com/design/Ey9gKqsJd8qx1aBMgefEQB/qader-app?node-id=4362-57196
// https://www.figma.com/design/Ey9gKqsJd8qx1aBMgefEQB/qader-app?node-id=4457-77401
// Hiring completion -> Contracts/engagements:
// https://www.figma.com/design/Ey9gKqsJd8qx1aBMgefEQB/qader-app?node-id=3649-29356
// Assistance -> Support/internal_notes/workflow_events:
// https://www.figma.com/design/Ey9gKqsJd8qx1aBMgefEQB/qader-app?node-id=3941-42237
// Public jobs + fixed identity/questions + submissions -> JobsForms:
// https://www.figma.com/design/Ey9gKqsJd8qx1aBMgefEQB/qader-app?node-id=4541-62666
// https://www.figma.com/design/Ey9gKqsJd8qx1aBMgefEQB/qader-app?node-id=4549-65134
// https://www.figma.com/design/Ey9gKqsJd8qx1aBMgefEQB/qader-app?node-id=4414-76117
//

Project qader_web_schema_review {
  Note: 'Review-only target schema; no migrations or live database changes. See decisions D01-D16 and constraints C01-C10.'
}

// [CHANGE] users
Table users [headercolor: #fef3c7] {
  id bigint [pk, increment]
  first_name varchar(255) [not null]
  last_name varchar(255) [not null]
  email varchar(255) [not null]
  email_verified_at timestamp
  password varchar(255) [not null]
  type varchar(255) [not null, note: 'talent | client | admin']
  avatar varchar(255)
  is_active boolean [not null, default: true]
  last_login_at timestamp
  remember_token varchar(100)
  timezone varchar(64) [note: 'ADD: IANA timezone; UTC when unset']
  locale varchar(10) [note: 'ADD: en/ar preference']
  suspended_at timestamp [note: 'ADD']
  suspension_reason text [note: 'ADD: internal only']
  deleted_at timestamp [note: 'ADD: retention proposal D09']
  created_at timestamp
  updated_at timestamp
  indexes {
    (email, type) [unique]
    type
  }
  Note: '[CHANGE] Existing identity. ADD timezone, locale, suspended_at, suspension_reason, deleted_at. Keep UNIQUE(email,type); do not move workspace identity here.'
}

// [CHANGE] clients
Table clients [headercolor: #fef3c7] {
  id bigint [pk, increment]
  user_id bigint [not null, unique]
  phone_country_code varchar(5) [note: 'ADD']
  phone_number varchar(20) [note: 'ADD']
  created_at timestamp
  updated_at timestamp
  Note: '[CHANGE] Existing one-to-one profile. ADD contact fields; admins also localized display name. Phone is not a login identifier.'
}

// [CHANGE] admins
Table admins [headercolor: #fef3c7] {
  id bigint [pk, increment]
  user_id bigint [not null, unique]
  phone_country_code varchar(5) [note: 'ADD']
  phone_number varchar(20) [note: 'ADD']
  display_name_ar varchar(255) [note: 'ADD; English display uses users first/last name']
  created_at timestamp
  updated_at timestamp
  Note: '[CHANGE] Existing one-to-one profile. ADD contact fields; admins also localized display name. Phone is not a login identifier.'
}

// [KEEP] social_accounts
Table social_accounts [headercolor: #dbeafe] {
  id bigint [pk, increment]
  user_id bigint [not null]
  provider varchar(255) [not null]
  provider_user_id varchar(255) [not null]
  email varchar(255) [not null]
  name varchar(255)
  avatar varchar(255)
  created_at timestamp
  updated_at timestamp
  indexes {
    (provider, provider_user_id) [unique]
    (email, provider)
  }
  Note: '[KEEP] Existing global provider identity uniqueness. Portal linking policy needs review; no silent cross-portal login.'
}

