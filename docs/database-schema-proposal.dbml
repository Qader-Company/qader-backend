// [KEEP] media
Table media [headercolor: #dbeafe] {
  id bigint [pk, increment]
  model_type varchar(255) [not null]
  model_id bigint [not null]
  uuid uuid [unique]
  collection_name varchar(255) [not null]
  name varchar(255) [not null]
  file_name varchar(255) [not null]
  mime_type varchar(255)
  disk varchar(255) [not null]
  conversions_disk varchar(255)
  size bigint [not null]
  manipulations json [not null]
  custom_properties json [not null]
  generated_conversions json [not null]
  responsive_images json [not null]
  order_column int
  created_at timestamp
  updated_at timestamp
  indexes {
    (model_type, model_id)
    order_column
  }
  Note: '[KEEP] Existing Spatie polymorphic files. Collection ownership is enforced in application policies. Historical referenced files must not be replaced/deleted; see C07.'
}

// [CHANGE] talent_applications
Table talent_applications [headercolor: #fef3c7] {
  id bigint [pk, increment]
  talent_id bigint [not null]
  status varchar(255) [not null, default: 'submitted', note: 'submitted | under_review | interview_required | interview_scheduled | waiting_result | accepted | rejected | closed; map legacy approved after audit']
  submitted_at timestamp [not null]
  reference varchar(32) [unique, note: 'ADD; backfill then NOT NULL']
  attempt_number int [not null, default: 1]
  active_guard tinyint [note: '1 for active attempt, NULL for terminal; CHECK with status; D01/C02']
  assigned_admin_id bigint
  review_started_at timestamp
  profile_locked_at timestamp
  profile_completion_at_submission tinyint
  submission_snapshot json [note: 'Immutable normalized profile, lookups and form policy snapshot; intentionally NEW, D02']
  snapshot_version int
  snapshot_captured_at timestamp
  snapshot_origin varchar(32) [note: 'submission | legacy_capture; do not fabricate old profile state']
  decision_at timestamp
  decided_by_admin_id bigint
  rejection_stage varchar(32) [note: 'initial_review | interview | scheduling']
  rejection_category varchar(64)
  internal_decision_reason text
  talent_visible_message text
  reapply_policy varchar(32) [note: 'allowed_after_date | not_allowed | early_paid_eligible']
  reapply_at timestamp
  priority varchar(16) [not null, default: 'normal', note: 'DOC: normal | high | urgent']
  last_activity_at timestamp
  version int [not null, default: 1, note: 'Optimistic lock']
  created_at timestamp
  updated_at timestamp
  indexes {
    (talent_id, attempt_number) [unique]
    (talent_id, active_guard) [unique]
    (assigned_admin_id, status, submitted_at)
    (status, submitted_at)
    reapply_at
  }
  Note: '[CHANGE] Existing id,talent_id,status,submitted_at,timestamps. CHANGE remove UNIQUE(talent_id), add attempt uniqueness and one active attempt constraint C02. Every other field below is ADD. Never rewrite previous attempts.'
}

// [NEW] talent_blacklist_entries
Table talent_blacklist_entries [headercolor: #dcfce7] {
  id bigint [pk, increment]
  talent_id bigint [not null]
  application_id bigint
  reason text [not null]
  blocked_by_admin_id bigint [not null]
  blocked_at timestamp [not null]
  active_guard tinyint [note: '1 when active, NULL after removal; CHECK with removed_at']
  removed_at timestamp
  removed_by_admin_id bigint
  removal_reason text
  created_at timestamp
  updated_at timestamp
  indexes {
    (talent_id, active_guard) [unique]
  }
  Note: '[NEW] Figma 3130:26016 / 3130:26553. Block is talent-wide; removing a block does not accept/reopen old applications.'
}

// [NEW] talent_marketplace_profiles
Table talent_marketplace_profiles [headercolor: #dcfce7] {
  id bigint [pk, increment]
  talent_id bigint [not null, unique]
  application_id bigint [not null]
  job_title_id bigint [not null]
  professional_field_id bigint [not null]
  seniority_level varchar(32) [not null]
  years_of_experience smallint [not null]
  public_summary text
  main_specialization varchar(255)
  salary_min decimal(18,4) [not null]
  salary_max decimal(18,4) [not null]
  currency_id bigint [not null]
  salary_period varchar(16) [not null, default: 'month']
  visibility varchar(16) [not null, default: 'hidden', note: 'visible | hidden']
  public_profile_snapshot json [not null, note: 'Approved safe experiences/projects/languages/work preferences; never raw private profile']
  approved_at timestamp [not null]
  approved_by_admin_id bigint [not null]
  created_at timestamp
  updated_at timestamp
  indexes {
    (visibility, professional_field_id, job_title_id, seniority_level)
    (currency_id, salary_min, salary_max)
  }
  Note: '[NEW] Approved public projection, separate from editable submission. Figma 3260:24102 and admin acceptance; DOC supports approved overrides. Application must belong to talent and be accepted.'
}

// [NEW] marketplace_profile_skills
Table marketplace_profile_skills [headercolor: #dcfce7] {
  marketplace_profile_id bigint [not null]
  skill_id bigint [not null]
  indexes {
    (marketplace_profile_id, skill_id) [pk]
  }
  Note: '[NEW] Filterable approved skill set. No inferred proficiency rating.'
}

// [NEW] industries
Table industries [headercolor: #dcfce7] {
  id bigint [pk, increment]
  slug varchar(255) [not null, unique]
  is_active boolean [not null, default: true]
  created_at timestamp
  updated_at timestamp
  Note: '[NEW] Workspace industry and marketplace industry experience; not interchangeable with professional field.'
}

// [NEW] industry_translations
Table industry_translations [headercolor: #dcfce7] {
  id bigint [pk, increment]
  industry_id bigint [not null]
  locale varchar(10) [not null]
  name varchar(255) [not null]
  indexes {
    (industry_id, locale) [unique]
  }
  Note: '[NEW] Translated industry catalog.'
}

// [NEW] marketplace_profile_industries
Table marketplace_profile_industries [headercolor: #dcfce7] {
  marketplace_profile_id bigint [not null]
  industry_id bigint [not null]
  indexes {
    (marketplace_profile_id, industry_id) [pk]
  }
  Note: '[NEW] Figma 3260:24102 Industry Experience. Admin-curated until capture source is agreed, D16.'
}

// [NEW] workspaces
Table workspaces [headercolor: #dcfce7] {
  id bigint [pk, increment]
  owner_client_id bigint [not null]
  name varchar(255) [not null]
  slug varchar(255) [not null, unique]
  industry_id bigint [not null]
  description text [not null]
  is_company boolean [not null]
  country_id bigint [not null]
  city_id bigint
  size_band varchar(32)
  website_url varchar(2048)
  commercial_registration_number varchar(100)
  status varchar(32) [not null, default: 'active', note: 'active | suspended | archived; approval pending not evidenced by workspace flow']
  timezone varchar(64) [not null]
  default_currency_id bigint
  deleted_at timestamp
  created_at timestamp
  updated_at timestamp
  indexes {
    (owner_client_id, status)
  }
  Note: '[NEW] Figma 3174:19565,3166:18282,4287:55632. Company/business belongs to workspace; client is an individual account.'
}

// [NEW] workspace_social_links
Table workspace_social_links [headercolor: #dcfce7] {
  id bigint [pk, increment]
  workspace_id bigint [not null]
  platform varchar(32) [not null]
  url varchar(2048) [not null]
  display_order smallint [not null, default: 0]
  created_at timestamp
  updated_at timestamp
  Note: '[NEW] Add Link in workspace setup.'
}

// [NEW] workspace_members
Table workspace_members [headercolor: #dcfce7] {
  id bigint [pk, increment]
  workspace_id bigint [not null]
  client_id bigint [not null]
  status varchar(16) [not null, default: 'active', note: 'active | suspended | removed']
  joined_at timestamp [not null]
  removed_at timestamp
  created_at timestamp
  updated_at timestamp
  indexes {
    (workspace_id, client_id) [unique]
    (client_id, status)
  }
  Note: '[NEW] One client can belong to many workspaces. Owner must also have an active member row; owner changes atomic. Members are client identities, not hired talents.'
}

// [NEW] workspace_roles
Table workspace_roles [headercolor: #dcfce7] {
  id bigint [pk, increment]
  workspace_id bigint [not null]
  key varchar(100) [not null]
  name_en varchar(255) [not null]
  name_ar varchar(255)
  is_active boolean [not null, default: true]
  created_at timestamp
  updated_at timestamp
  indexes {
    (workspace_id, key) [unique]
  }
  Note: '[NEW] Figma 4178:54523 and reused role dialog. Dedicated scope because existing Spatie teams=false. Workspace-local authorization only.'
}

// [NEW] workspace_role_permissions
Table workspace_role_permissions [headercolor: #dcfce7] {
  workspace_role_id bigint [not null]
  permission_id bigint [not null]
  indexes {
    (workspace_role_id, permission_id) [pk]
  }
  Note: '[NEW] Only permissions.portal=client may be attached.'
}

// [NEW] workspace_member_roles
Table workspace_member_roles [headercolor: #dcfce7] {
  workspace_member_id bigint [not null]
  workspace_role_id bigint [not null]
  indexes {
    (workspace_member_id, workspace_role_id) [pk]
  }
  Note: '[NEW] Member and role must belong to the same workspace; C01 validation required.'
}

// [PROPOSED] workspace_invitations
Table workspace_invitations [headercolor: #f3e8ff] {
  id bigint [pk, increment]
  workspace_id bigint [not null]
  email varchar(255) [not null]
  role_id bigint
  invited_by_member_id bigint [not null]
  token_hash char(64) [not null, unique]
  status varchar(16) [not null, default: 'pending', note: 'pending | accepted | revoked | expired']
  expires_at timestamp [not null]
  accepted_by_client_id bigint
  accepted_at timestamp
  created_at timestamp
  updated_at timestamp
  indexes {
    (workspace_id, email, status)
  }
  Note: '[PROPOSED] Supporting membership flow; exact invitation UI not designed. Do not implement until membership scope approved.'
}

// [NEW] contract_types
Table contract_types [headercolor: #dcfce7] {
  id bigint [pk, increment]
  code varchar(32) [not null, unique, note: 'managed | one_time']
  is_active boolean [not null, default: true]
  created_at timestamp
  updated_at timestamp
  Note: '[NEW] System-defined managed and one_time types, 3916:38766. Pricing details versioned separately.'
}

// [NEW] contract_type_versions
Table contract_type_versions [headercolor: #dcfce7] {
  id bigint [pk, increment]
  contract_type_id bigint [not null]
  version_number int [not null]
  status varchar(16) [not null, default: 'draft', note: 'draft | published | retired']
  name_en varchar(255) [not null]
  name_ar varchar(255) [not null]
  description_en text
  description_ar text
  terms_en text
  terms_ar text
  default_work_type varchar(32)
  default_work_mode varchar(32)
  default_schedule json [note: 'Validated weekdays, local start/end, timezone, hybrid onsite days, location']
  published_at timestamp
  created_by_admin_id bigint [not null]
  created_at timestamp
  updated_at timestamp
  indexes {
    (contract_type_id, version_number) [unique]
  }
  Note: '[NEW] 3916:42854. Published versions immutable. Fee cadence and percentage basis require D07 approval.'
}

// [NEW] contract_type_benefits
Table contract_type_benefits [headercolor: #dcfce7] {
  id bigint [pk, increment]
  contract_type_version_id bigint [not null]
  name_en varchar(255) [not null]
  name_ar varchar(255)
  display_order smallint [not null]
  created_at timestamp
  updated_at timestamp
  indexes {
    (contract_type_version_id, display_order) [unique]
  }
  Note: '[NEW] Ordered benefits per published configuration.'
}

// [NEW] contract_fee_rules
Table contract_fee_rules [headercolor: #dcfce7] {
  id bigint [pk, increment]
  contract_type_version_id bigint [not null]
  professional_field_id bigint
  scope_key varchar(64) [not null, note: 'default when field NULL, field:<id> otherwise; CHECK/transaction invariant']
  fee_type varchar(32) [not null, note: 'fixed | percentage | fixed_percentage']
  fixed_amount decimal(18,4)
  fixed_currency_id bigint
  percentage decimal(7,4)
  percentage_basis varchar(32) [note: 'monthly_salary | annual_salary | contract_total; D07']
  billing_frequency varchar(16) [not null, note: 'monthly | one_time']
  created_at timestamp
  updated_at timestamp
  indexes {
    (contract_type_version_id, scope_key) [unique]
  }
  Note: '[NEW] Default + professional-field override; never hard-code Figma sample amounts. One default rule and at most one override per field/version.'
}

// [NEW] hiring_requests
Table hiring_requests [headercolor: #dcfce7] {
  id bigint [pk, increment]
  workspace_id bigint [not null]
  reference varchar(32) [not null, unique]
  created_by_member_id bigint [not null]
  assigned_admin_id bigint
  currency_id bigint [not null]
  status varchar(32) [not null, default: 'draft', note: 'draft | submitted | in_progress | completed | cancelled; aggregate rules C04']
  submitted_at timestamp
  closed_at timestamp
  version int [not null, default: 1]
  created_at timestamp
  updated_at timestamp
  indexes {
    (workspace_id, status, created_at)
    (assigned_admin_id, status)
  }
  Note: '[NEW] One workspace request, many independently progressing items. Draft is the persisted squad; no second cart model.'
}

// [NEW] hiring_request_items
Table hiring_request_items [headercolor: #dcfce7] {
  id bigint [pk, increment]
  hiring_request_id bigint [not null]
  talent_id bigint [not null]
  replaces_item_id bigint [unique]
  reference varchar(32) [not null, unique]
  job_title_id bigint [not null]
  contract_type_version_id bigint [not null]
  interview_required boolean [not null]
  status varchar(32) [not null, default: 'draft', note: 'draft | awaiting_response | negotiating | interview_scheduling | interview_scheduled | awaiting_decisions | accepted | ready_for_contract | contracted | rejected | cancelled | on_hold | replaced']
  resume_status varchar(32) [note: 'Saved pre-hold stage; never resurrect cancelled interviews/offers']
  active_guard tinyint [note: '1 active, NULL terminal; prevents duplicate active talent in request']
  accepted_offer_id bigint
  held_at timestamp
  cancelled_at timestamp
  closed_at timestamp
  last_activity_at timestamp
  closure_reason_code varchar(64) [note: 'talent_rejected | client_rejected | no_response | cancelled | replaced; separate from actor']
  version int [not null, default: 1]
  created_at timestamp
  updated_at timestamp
  indexes {
    (hiring_request_id, talent_id, active_guard) [unique]
    (hiring_request_id, status)
    (talent_id, status, created_at)
  }
  Note: '[NEW] Figma 3290:38355,3955:51181. Never overwrite the original talent when selecting a replacement. Same-request replacements form a chain.'
}

// [NEW] hiring_offers
Table hiring_offers [headercolor: #dcfce7] {
  id bigint [pk, increment]
  request_item_id bigint [not null]
  version_number int [not null]
  parent_offer_id bigint
  origin_party varchar(16) [not null, note: 'client | talent']
  created_by_user_id bigint [not null]
  on_behalf_of_user_id bigint
  salary_amount decimal(18,4) [not null]
  currency_id bigint [not null]
  salary_period varchar(16) [not null, default: 'month']
  work_type varchar(32) [not null]
  work_mode varchar(32) [not null]
  notice_period_days smallint
  contract_duration_months smallint
  proposed_start_date date
  work_schedule json [not null, note: 'C06: weekdays, local times or daily hours, timezone, hybrid onsite days, location']
  message text
  status varchar(16) [not null, default: 'draft', note: 'draft | sent | accepted | rejected | superseded | withdrawn | expired']
  sent_at timestamp
  response_due_at timestamp
  responded_at timestamp
  responded_by_user_id bigint
  response_on_behalf_of_user_id bigint
  response_reason text
  created_at timestamp
  updated_at timestamp
  indexes {
    (request_item_id, version_number) [unique]
    (status, response_due_at)
  }
  Note: '[NEW] Versioned offer/counteroffer terms. Figma 3670:31371,3733:40359,4292:113232. Draft terms can change; sent terms immutable.'
}

// [NEW] hiring_item_decisions
Table hiring_item_decisions [headercolor: #dcfce7] {
  id bigint [pk, increment]
  request_item_id bigint [not null]
  interview_id bigint [not null]
  party varchar(16) [not null, note: 'client | talent']
  decision varchar(16) [not null, note: 'continue | reject']
  decided_by_user_id bigint [not null]
  on_behalf_of_user_id bigint
  reason text
  decided_at timestamp [not null]
  withdrawn_at timestamp [note: 'Cancellation of decision, 4308:55492; preserve audit']
  active_guard tinyint [note: '1 current decision, NULL withdrawn']
  created_at timestamp
  updated_at timestamp
  indexes {
    (interview_id, party, active_guard) [unique]
  }
  Note: '[NEW] Independent client/talent post-interview choices. Figma 4032:56278/57814/58772/61781; admin acts on behalf without hiding actual actor.'
}

// [NEW] replacement_candidates
Table replacement_candidates [headercolor: #dcfce7] {
  id bigint [pk, increment]
  original_item_id bigint [not null]
  talent_id bigint [not null]
  proposed_by_admin_id bigint
  match_score decimal(5,2)
  match_reasons json
  status varchar(32) [not null, note: 'suggested | contacted | available | unavailable | presented | accepted | rejected']
  contacted_at timestamp
  contact_note text
  selected_item_id bigint [unique]
  decided_by_user_id bigint
  decided_at timestamp
  created_at timestamp
  updated_at timestamp
  indexes {
    (original_item_id, talent_id) [unique]
  }
  Note: '[NEW] Suggested candidates and contact/approval status; selecting one creates a new request item. 3411:21862 and 4263:58209.'
}

// [PROPOSED] candidate_invitations
Table candidate_invitations [headercolor: #f3e8ff] {
  id bigint [pk, increment]
  hiring_request_id bigint [not null]
  email varchar(255) [not null]
  invited_by_member_id bigint [not null]
  token_hash char(64) [not null, unique]
  expires_at timestamp [not null]
  status varchar(16) [not null, note: 'pending | accepted | expired | revoked']
  talent_id bigint
  created_at timestamp
  updated_at timestamp
  indexes {
    (hiring_request_id, email) [unique]
  }
  Note: '[PROPOSED] Invite candidate button at 3730:38377; onboarding/conversion not designed, D15. Never auto-approve invited talent.'
}

// [NEW] interviews
Table interviews [headercolor: #dcfce7] {
  id bigint [pk, increment]
  application_id bigint
  request_item_id bigint
  round_number smallint [not null]
  category varchar(32) [not null, note: 'hr | technical | general | final | behavioral | panel | group | phone | portfolio | other']
  session_status varchar(32) [not null, note: 'awaiting_slots | selecting_slot | scheduled | ready | started | completed | no_show | cancelled']
  selected_slot_id bigint [unique]
  scheduled_start_at timestamp
  scheduled_end_at timestamp
  google_calendar_event_id varchar(255) [note: 'Set only after the talent selects a slot and Google Calendar event creation succeeds']
  meeting_url text [note: 'Google Meet URL set with the selected slot; never created for every offered slot']
  actual_start_at timestamp
  actual_end_at timestamp
  decision_due_at timestamp [note: 'Hiring decisions: snapshot configured 1-day period, not a hard-coded UI sample']
  created_by_admin_id bigint [not null]
  notes_internal text
  completed_by_user_id bigint
  version int [not null, default: 1]
  created_at timestamp
  updated_at timestamp
  indexes {
    (application_id, round_number) [unique]
    (request_item_id, round_number) [unique]
    (session_status, scheduled_start_at)
  }
  Note: '[NEW] Shared scheduling engine, two explicit contexts. Exactly ONE of application_id/request_item_id is non-null (CHECK). Each row is a logical interview round; reschedules are scheduling rounds below.'
}

// [NEW] interview_participants
Table interview_participants [headercolor: #dcfce7] {
  id bigint [pk, increment]
  interview_id bigint [not null]
  user_id bigint [not null]
  participant_role varchar(16) [not null, note: 'interviewer | talent | client']
  attendance varchar(16) [not null, default: 'unknown', note: 'unknown | attended | no_show | excused']
  joined_at timestamp
  left_at timestamp
  created_at timestamp
  updated_at timestamp
  indexes {
    (interview_id, user_id) [unique]
    (user_id, interview_id)
  }
  Note: '[NEW] One/multiple interviewers and talent/client attendees. Actual attendance distinct from booking choice.'
}

// [NEW] interview_scheduling_rounds
Table interview_scheduling_rounds [headercolor: #dcfce7] {
  id bigint [pk, increment]
  interview_id bigint [not null]
  sequence_number int [not null]
  policy_snapshot json [not null, note: 'Attempt/cancellation limits and response deadline policy used for this round']
  status varchar(32) [not null, note: 'draft | offered | selected | rejected_all | expired | cancelled']
  created_by_admin_id bigint [not null]
  published_at timestamp
  selection_due_at timestamp
  closed_at timestamp
  reason text
  initiated_by_user_id bigint
  quota_party varchar(16) [note: 'talent | client | admin | system; snapshot quota responsibility']
  created_at timestamp
  updated_at timestamp
  indexes {
    (interview_id, sequence_number) [unique]
    (status, selection_due_at)
  }
  Note: '[NEW] Every manually published set of available slots. Automatic slot generation is not supported. Talent reschedule quota counts party-caused events only; admin cancellation does not consume it.'
}

// [NEW] interview_slots
Table interview_slots [headercolor: #dcfce7] {
  id bigint [pk, increment]
  scheduling_round_id bigint [not null]
  starts_at timestamp [not null]
  ends_at timestamp [not null, note: 'Backend default is starts_at + 60 minutes; no duration/end input is added to the UI']
  mode varchar(16) [not null, note: 'online | offline']
  location_address text
  latitude decimal(10,7)
  longitude decimal(10,7)
  status varchar(32) [not null, default: 'available', note: 'available | selected | expired | cancelled | rejected_by_talent']
  created_at timestamp
  updated_at timestamp
  indexes {
    (scheduling_round_id, starts_at) [unique]
    (starts_at, ends_at, status)
  }
  Note: '[NEW] The current date/time UI is preserved; backend stores a start/end interval and defaults end to 60 minutes after start. Offline map position uses latitude/longitude. Google event ID and Meet URL are created once on the interview only after talent selects a slot. Every selected interviewer must be free for the entire interval.'
}

// [NEW] interview_slot_responses
Table interview_slot_responses [headercolor: #dcfce7] {
  id bigint [pk, increment]
  slot_id bigint [not null]
  user_id bigint [not null]
  response varchar(16) [not null, note: 'preferred | accepted | declined']
  responded_at timestamp [not null]
  created_at timestamp
  updated_at timestamp
  indexes {
    (slot_id, user_id) [unique]
  }
  Note: '[NEW] Party selections/preferences permit a common client/talent slot; exact selection protocol D06. One confirmed slot chosen transactionally.'
}

// [NEW] interview_reschedule_requests
Table interview_reschedule_requests [headercolor: #dcfce7] {
  id bigint [pk, increment]
  interview_id bigint [not null]
  original_slot_id bigint [not null]
  requested_by_user_id bigint [not null]
  reason text [not null]
  proposed_start_at timestamp
  proposed_end_at timestamp
  proposed_timezone varchar(64)
  status varchar(16) [not null, default: 'pending', note: 'pending | approved | declined | withdrawn']
  reviewed_by_admin_id bigint
  reviewed_at timestamp
  review_note text
  created_at timestamp
  updated_at timestamp
  indexes {
    (interview_id, status)
  }
  Note: '[NEW] 4315:68038 / 4315:68393. Talent UI requires reason; admin screen includes proposed time; optional until collected.'
}

// [NEW] evaluation_criteria
Table evaluation_criteria [headercolor: #dcfce7] {
  id bigint [pk, increment]
  key varchar(100) [not null, unique]
  name_en varchar(255) [not null]
  name_ar varchar(255)
  default_weight decimal(5,2)
  is_active boolean [not null, default: true]
  display_order smallint [not null]
  created_at timestamp
  updated_at timestamp
  Note: '[NEW] Figma four criteria rated 1-5. DOC six criteria/weights is not authoritative; configurable catalog, seed only approved criteria.'
}

// [NEW] talent_evaluations
Table talent_evaluations [headercolor: #dcfce7] {
  id bigint [pk, increment]
  application_id bigint [not null]
  interview_id bigint
  stage_key varchar(64) [not null, note: 'profile or interview:<id>; matches interview_id when set']
  version_number int [not null]
  evaluator_admin_id bigint [not null]
  status varchar(16) [not null, note: 'draft | submitted | superseded']
  overall_score decimal(5,2)
  recommended_salary_min decimal(18,4)
  recommended_salary_max decimal(18,4)
  currency_id bigint
  salary_period varchar(16) [note: 'month | year; UI currently conflicts, D08']
  hr_report text
  technical_report text
  psychology_report text
  final_feedback text
  submitted_at timestamp
  created_at timestamp
  updated_at timestamp
  indexes {
    (application_id, stage_key, version_number) [unique]
  }
  Note: '[NEW] 1008:13597,1030:9753,1045:17994. Immutable submitted revisions; evaluation is not application decision. Internal fields never sold directly.'
}

// [NEW] evaluation_scores
Table evaluation_scores [headercolor: #dcfce7] {
  id bigint [pk, increment]
  evaluation_id bigint [not null]
  criterion_id bigint [not null]
  label_snapshot varchar(255) [not null]
  weight decimal(5,2) [not null]
  rating tinyint [not null]
  comment text
  created_at timestamp
  updated_at timestamp
  indexes {
    (evaluation_id, criterion_id) [unique]
  }
  Note: '[NEW] Snapshot criterion label and weight so changing catalog does not change historical score. rating 1..5; score 0..100; weights sum=100 when submitted.'
}

// [NEW] evaluation_tips
Table evaluation_tips [headercolor: #dcfce7] {
  id bigint [pk, increment]
  evaluation_id bigint [not null]
  title varchar(255) [not null]
  description text [not null]
  priority varchar(16) [not null, note: 'low | medium | high']
  display_order smallint [not null]
  created_at timestamp
  updated_at timestamp
  Note: '[NEW] Named tips with priority and order, Figma 1008:13597.'
}

// [NEW] expert_reports
Table expert_reports [headercolor: #dcfce7] {
  id bigint [pk, increment]
  talent_id bigint [not null]
  application_id bigint [not null]
  evaluation_id bigint
  audience varchar(16) [not null, note: 'talent | client']
  kind varchar(32) [not null, note: 'profile_review | rejection_feedback | hiring_opinion']
  version_number int [not null]
  status varchar(16) [not null, note: 'draft | published | withdrawn']
  strengths text
  improvement_areas text
  final_feedback text
  published_content json [note: 'Allowlisted score breakdown, tips, CV review, salary analysis; excludes internal/private notes']
  overall_score decimal(5,2)
  rank_percentile decimal(5,2)
  rank_population int
  ranking_as_of timestamp
  ranking_method varchar(255)
  published_at timestamp
  published_by_admin_id bigint
  created_at timestamp
  updated_at timestamp
  indexes {
    (application_id, audience, kind, version_number) [unique]
  }
  Note: '[NEW] Curated audience-specific publication, not unrestricted exposure of internal evaluations. Figma 3098:15273 / 3260:27929.'
}

// [NEW] talent_account_warnings
Table talent_account_warnings [headercolor: #dcfce7] {
  id bigint [pk, increment]
  talent_id bigint [not null]
  offer_id bigint [not null]
  category varchar(32) [not null, note: 'no_response']
  issued_by_admin_id bigint [not null]
  reason text [not null]
  policy_snapshot json [not null]
  issued_at timestamp [not null]
  expires_at timestamp
  revoked_at timestamp
  revoked_by_admin_id bigint
  revocation_reason text
  created_at timestamp
  updated_at timestamp
  indexes {
    (offer_id, category) [unique]
    (talent_id, revoked_at, expires_at)
  }
  Note: '[NEW] Figma 3670:34090 and 4292:111785: admin no-response closure issues a warning. Warnings are not blacklist entries; suspension threshold is policy, not the sample remaining=1.'
}

// [NEW] help_requests
Table help_requests [headercolor: #dcfce7] {
  id bigint [pk, increment]
  reference varchar(32) [not null, unique]
  workspace_id bigint
  created_by_user_id bigint
  source varchar(16) [not null, note: 'public | workspace']
  contact_name varchar(255) [not null]
  contact_email varchar(255)
  contact_phone varchar(32)
  country_id bigint
  preferred_contact varchar(16) [not null, note: 'email | whatsapp | phone']
  help_type varchar(64) [not null]
  title varchar(255)
  description text
  assigned_admin_id bigint
  status varchar(16) [not null, default: 'new', note: 'new | in_progress | closed']
  started_at timestamp
  closed_at timestamp
  closed_by_admin_id bigint
  closure_outcome varchar(32) [note: 'hiring_request_created | clarified | issue_identified']
  resolution_details text
  linked_hiring_request_id bigint
  created_at timestamp
  updated_at timestamp
  indexes {
    (assigned_admin_id, status, created_at)
    (workspace_id, status)
  }
  Note: '[NEW] 3884:35731,3921:46209,3941:42237. Also handles public hiring support with nullable workspace and captured contact details.'
}

// [NEW] job_postings
Table job_postings [headercolor: #dcfce7] {
  id bigint [pk, increment]
  professional_field_id bigint [not null]
  job_title_id bigint
  title varchar(255) [not null, note: 'Public role title can be free text']
  slug varchar(255) [not null, unique]
  summary text [not null]
  about_role text [not null]
  work_type varchar(32) [not null]
  work_mode varchar(32) [not null]
  seniority_level varchar(32)
  country_id bigint
  city_id bigint
  department varchar(255)
  status varchar(16) [not null, default: 'draft', note: 'draft | published | closed | archived']
  published_at timestamp
  closed_at timestamp
  created_by_admin_id bigint [not null]
  deleted_at timestamp [note: 'Archive form with submissions; D09']
  created_at timestamp
  updated_at timestamp
  indexes {
    (status, professional_field_id, published_at)
  }
  Note: '[NEW] 4541:62666 / 4528:95530. Qader public openings; workspace ownership not evidenced. Do not use jobs (Laravel queue).'
}

// [NEW] job_posting_sections
Table job_posting_sections [headercolor: #dcfce7] {
  id bigint [pk, increment]
  job_posting_id bigint [not null]
  section varchar(32) [not null, note: 'responsibility | requirement | qualification | benefit']
  content text [not null]
  display_order smallint [not null]
  created_at timestamp
  updated_at timestamp
  indexes {
    (job_posting_id, section, display_order) [unique]
  }
  Note: '[NEW] Ordered public responsibilities, requirements, what-we-look-for and optional benefits.'
}

// [NEW] job_posting_skills
Table job_posting_skills [headercolor: #dcfce7] {
  job_posting_id bigint [not null]
  skill_id bigint [not null]
  indexes {
    (job_posting_id, skill_id) [pk]
  }
  Note: '[NEW] Searchable skills on public job cards.'
}

// [NEW] job_question_catalog
Table job_question_catalog [headercolor: #dcfce7] {
  id bigint [pk, increment]
  key varchar(100) [not null, unique]
  professional_field_id bigint
  label varchar(255) [not null]
  prompt text
  input_type varchar(32) [not null, note: 'text | textarea | number | select | multiselect | url | file | date']
  validation_rules json [note: 'Whitelisted rules only; never executable rule strings from users']
  options json [note: 'Versioned key/label pairs copied into form fields']
  is_active boolean [not null, default: true]
  created_at timestamp
  updated_at timestamp
  Note: '[NEW] 4549:65134 Choose existing fields. Separate from onboarding registry. No freeform question creation required by current UI.'
}

// [NEW] job_forms
Table job_forms [headercolor: #dcfce7] {
  id bigint [pk, increment]
  job_posting_id bigint [not null, unique]
  title varchar(255) [not null]
  description text
  public_token varchar(100) [not null, unique]
  is_active boolean [not null, default: false]
  created_by_admin_id bigint [not null]
  deleted_at timestamp
  created_at timestamp
  updated_at timestamp
  Note: '[NEW] One versioned form per job; copy action creates new form/posting identities, not duplicated submissions.'
}

// [NEW] job_form_versions
Table job_form_versions [headercolor: #dcfce7] {
  id bigint [pk, increment]
  job_form_id bigint [not null]
  version_number int [not null]
  status varchar(16) [not null, note: 'draft | published | retired']
  identity_fields_snapshot json [not null, note: 'Exactly four fixed required fields: name,email,mobile,job_title; title server-filled']
  published_at timestamp
  created_at timestamp
  updated_at timestamp
  indexes {
    (job_form_id, version_number) [unique]
  }
  Note: '[NEW] Immutable when published; old submissions render exact historical fields and job identity.'
}

// [NEW] job_form_fields
Table job_form_fields [headercolor: #dcfce7] {
  id bigint [pk, increment]
  form_version_id bigint [not null]
  catalog_question_id bigint [not null]
  field_key varchar(100) [not null]
  label varchar(255) [not null]
  prompt text
  input_type varchar(32) [not null]
  is_required boolean [not null, default: false]
  validation_rules json
  options json
  display_order smallint [not null]
  created_at timestamp
  updated_at timestamp
  indexes {
    (form_version_id, field_key) [unique]
    (form_version_id, display_order) [unique]
  }
  Note: '[NEW] Selected additional questions; snapshots retain labels/types/options despite catalog changes.'
}

// [NEW] job_form_submissions
Table job_form_submissions [headercolor: #dcfce7] {
  id bigint [pk, increment]
  form_version_id bigint [not null]
  applicant_user_id bigint
  applicant_name varchar(255) [not null]
  email varchar(255) [not null]
  mobile_number varchar(32) [not null]
  job_title_snapshot varchar(255) [not null]
  status varchar(32) [not null, default: 'received', note: 'received | reviewed | converted | archived']
  submission_key uuid [not null, unique, note: 'Idempotency key; email alone is not unique']
  consent_at timestamp [not null]
  submitted_at timestamp [not null]
  converted_talent_id bigint
  converted_application_id bigint
  converted_by_admin_id bigint
  converted_at timestamp
  created_at timestamp
  updated_at timestamp
  indexes {
    (form_version_id, submitted_at)
    email
  }
  Note: '[NEW] Guest submissions permitted by public Figma form. Not automatically a vetted talent. Start Hiring Process conversion requires D14.'
}

// [NEW] job_form_answers
Table job_form_answers [headercolor: #dcfce7] {
  id bigint [pk, increment]
  submission_id bigint [not null]
  form_field_id bigint [not null]
  value json
  media_id bigint
  created_at timestamp
  updated_at timestamp
  indexes {
    (submission_id, form_field_id) [unique]
  }
  Note: '[NEW] Submission and field must share a form version. Typed JSON value; selected values must exist in frozen options. File answers use attached media.'
}

// [PROPOSED] saved_job_postings
Table saved_job_postings [headercolor: #f3e8ff] {
  user_id bigint [not null]
  job_posting_id bigint [not null]
  created_at timestamp
  updated_at timestamp
  indexes {
    (user_id, job_posting_id) [pk]
  }
  Note: '[PROPOSED] Save Job is visible at 4528:95530; logged-in persistence proposed, guest behavior unspecified.'
}

// [NEW] currency_exchange_rates
Table currency_exchange_rates [headercolor: #dcfce7] {
  id bigint [pk, increment]
  base_currency_id bigint [not null]
  currency_id bigint [not null]
  rate_to_base decimal(24,12) [not null]
  source varchar(64) [not null]
  effective_at timestamp [not null]
  fetched_at timestamp [not null]
  created_by_admin_id bigint
  indexes {
    (base_currency_id, currency_id, effective_at) [unique]
  }
  Note: '[NEW] DOC architecture/08 + Flow01. Append-only historical rates; 1 currency unit = rate_to_base base units. No provider integration implied.'
}

// [NEW] currency_conversion_quotes
Table currency_conversion_quotes [headercolor: #dcfce7] {
  id bigint [pk, increment]
  source_currency_id bigint [not null]
  target_currency_id bigint [not null]
  source_rate_id bigint [not null]
  target_rate_id bigint [not null]
  effective_rate decimal(24,12) [not null]
  original_amount decimal(18,4) [not null]
  converted_amount decimal(18,4) [not null]
  quoted_at timestamp [not null]
  expires_at timestamp
  Note: '[NEW] Immutable issued conversion quote: even display conversions return quote ID/rate snapshot. Retention for uncommitted quotes is D12; financial quotes retained.'
}

// [NEW] invoices
Table invoices [headercolor: #dcfce7] {
  id bigint [pk, increment]
  reference varchar(32) [not null, unique]
  workspace_id bigint
  payer_user_id bigint [not null]
  hiring_request_id bigint
  currency_id bigint [not null]
  status varchar(32) [not null, default: 'draft', note: 'draft | pending_fees | issued | partially_paid | paid | void | refunded']
  fee_status varchar(16) [not null, default: 'pending', note: 'pending | confirmed | not_applicable']
  salary_subtotal decimal(18,4) [not null, default: 0, note: 'Informational including direct-placement salary references']
  subtotal decimal(18,4)
  fees_total decimal(18,4)
  tax_total decimal(18,4)
  total_due decimal(18,4) [note: 'NULL until final fee confirmation; never invented sample totals']
  salary_confirmed_by_user_id bigint
  salary_confirmed_at timestamp
  final_confirmed_by_user_id bigint
  final_confirmed_at timestamp
  issued_at timestamp
  due_at timestamp
  paid_at timestamp
  period_start date
  period_end date
  created_at timestamp
  updated_at timestamp
  indexes {
    (workspace_id, status, created_at)
    (payer_user_id, created_at)
  }
  Note: '[NEW] A payment batch is a draft invoice with item lines. Figma 4362:57196: salary confirmation is not settlement and fees may be unknown.'
}

// [NEW] invoice_lines
Table invoice_lines [headercolor: #dcfce7] {
  id bigint [pk, increment]
  invoice_id bigint [not null]
  request_item_id bigint
  contract_id bigint
  subscription_id bigint
  line_type varchar(32) [not null, note: 'managed_salary | salary_reference | management_fee | placement_fee | subscription | premium_service | tax | adjustment']
  description varchar(255) [not null]
  quantity decimal(12,4) [not null, default: 1]
  unit_amount decimal(18,4)
  line_total decimal(18,4)
  included_in_total boolean [not null, default: true]
  pricing_snapshot json [note: 'Rule/version, basis, rate, amounts, rounding, benefits/terms where needed']
  conversion_quote_id bigint
  display_order smallint [not null]
  created_at timestamp
  updated_at timestamp
  indexes {
    (invoice_id, display_order) [unique]
  }
  Note: '[NEW] Immutable issued lines and fee snapshots. Direct placement salary_reference is excluded from amount due to Qader; managed salary is collectable.'
}

// [NEW] payments
Table payments [headercolor: #dcfce7] {
  id bigint [pk, increment]
  invoice_id bigint [not null]
  payer_user_id bigint [not null]
  currency_id bigint [not null]
  amount decimal(18,4) [not null]
  method varchar(32) [not null, note: 'bank_transfer | gateway']
  status varchar(32) [not null, default: 'pending', note: 'pending | receipt_submitted | under_review | succeeded | rejected | failed | partially_refunded | refunded']
  idempotency_key uuid [not null, unique]
  provider varchar(64)
  provider_reference varchar(255)
  bank_details_snapshot json [note: 'Beneficiary/account details shown when payment created; no Figma sample bank details seeded']
  receipt_media_id bigint
  submitted_at timestamp
  verified_by_admin_id bigint
  verified_at timestamp
  verification_note text
  created_at timestamp
  updated_at timestamp
  indexes {
    (provider, provider_reference) [unique]
    (invoice_id, status)
  }
  Note: '[NEW] Bank transfers with manual verification first. Multiple partial attempts per invoice. Receipt upload alone never sets succeeded. 4457:77401.'
}

// [PROPOSED] payment_refunds
Table payment_refunds [headercolor: #f3e8ff] {
  id bigint [pk, increment]
  payment_id bigint [not null]
  amount decimal(18,4) [not null]
  reason text [not null]
  status varchar(16) [not null, note: 'requested | approved | succeeded | failed']
  idempotency_key uuid [not null, unique]
  approved_by_admin_id bigint
  refunded_at timestamp
  created_at timestamp
  updated_at timestamp
  Note: '[PROPOSED] Refund support required if premium guarantee in 3089:16895 is approved. Amount never exceeds unrefunded settled payment.'
}

// [NEW] service_products
Table service_products [headercolor: #dcfce7] {
  id bigint [pk, increment]
  code varchar(64) [not null, unique]
  audience varchar(16) [not null, note: 'talent | client']
  name varchar(255) [not null]
  amount decimal(18,4) [not null]
  currency_id bigint [not null]
  benefits json [not null, note: 'Versioned snapshot copied to order; early reapply policy not automatic']
  is_active boolean [not null, default: true]
  created_at timestamp
  updated_at timestamp
  Note: '[NEW] Profile review, rejection feedback/early reapply, client expert opinion. UI sample prices differ; configuration only.'
}

// [NEW] service_orders
Table service_orders [headercolor: #dcfce7] {
  id bigint [pk, increment]
  product_id bigint [not null]
  buyer_user_id bigint [not null]
  workspace_id bigint
  talent_id bigint [not null]
  application_id bigint [not null]
  invoice_id bigint [not null, unique]
  product_snapshot json [not null]
  status varchar(32) [not null, note: 'awaiting_payment | paid | in_progress | fulfilled | cancelled | refunded']
  fulfillment_due_at timestamp
  fulfilled_at timestamp
  created_at timestamp
  updated_at timestamp
  indexes {
    (workspace_id, talent_id, status)
    (buyer_user_id, status)
  }
  Note: '[NEW] Invoice settlement buys fulfillment/access, not a talent approval. Scope proposed: talent user for own report; workspace for client opinion (D10).'
}

// [NEW] expert_report_access
Table expert_report_access [headercolor: #dcfce7] {
  id bigint [pk, increment]
  service_order_id bigint [not null]
  report_id bigint [not null]
  granted_at timestamp [not null]
  expires_at timestamp
  revoked_at timestamp
  created_at timestamp
  updated_at timestamp
  indexes {
    (service_order_id, report_id) [unique]
  }
  Note: '[NEW] Entitlement granted once payment succeeds and report is published. Private evaluation access is never implied. Refund revocation policy D10.'
}

// [DOC] subscription_plans
Table subscription_plans [headercolor: #e5e7eb] {
  id bigint [pk, increment]
  code varchar(64) [not null, unique]
  name varchar(255) [not null]
  amount decimal(18,4) [not null]
  currency_id bigint [not null]
  interval_unit varchar(16) [not null]
  interval_count smallint [not null]
  entitlements json [not null]
  is_active boolean [not null, default: true]
  created_at timestamp
  updated_at timestamp
  Note: '[DOC] BRD/PRD/SRS require access subscriptions; checkout/gating not confirmed by active web screens. D11 before implementation.'
}

// [DOC] workspace_subscriptions
Table workspace_subscriptions [headercolor: #e5e7eb] {
  id bigint [pk, increment]
  workspace_id bigint [not null]
  plan_id bigint [not null]
  status varchar(16) [not null, note: 'pending | active | expired | cancelled']
  plan_snapshot json [not null]
  starts_at timestamp [not null]
  ends_at timestamp [not null]
  cancelled_at timestamp
  created_at timestamp
  updated_at timestamp
  indexes {
    (workspace_id, status, ends_at)
  }
  Note: '[DOC] Proposed workspace-level access subscription; period/plan snapshot preserves paid entitlements. No global users.is_subscribed flag.'
}

// [NEW] contracts
Table contracts [headercolor: #dcfce7] {
  id bigint [pk, increment]
  reference varchar(32) [not null, unique]
  workspace_id bigint [not null]
  request_item_id bigint [not null, unique]
  accepted_offer_id bigint [not null]
  contract_type_version_id bigint [not null]
  talent_id bigint [not null]
  status varchar(32) [not null, note: 'draft | awaiting_signatures | signed | active | completed | terminated | cancelled']
  final_salary decimal(18,4) [not null]
  currency_id bigint [not null]
  salary_period varchar(16) [not null, default: 'month']
  terms_snapshot json [not null, note: 'Accepted work schedule, pricing rule/version, benefits, agreed terms']
  start_date date [not null]
  end_date date
  executed_at timestamp
  terminated_at timestamp
  termination_reason text
  created_at timestamp
  updated_at timestamp
  indexes {
    (workspace_id, status, start_date)
    (talent_id, status)
  }
  Note: '[NEW] Figma contracted states + BRD contract documents. One contract per successful item; company and talent documents are children. Complete signing/renewal UI not yet evidenced.'
}

// [NEW] contract_documents
Table contract_documents [headercolor: #dcfce7] {
  id bigint [pk, increment]
  contract_id bigint [not null]
  document_type varchar(16) [not null, note: 'company | talent | amendment']
  version_number int [not null]
  media_id bigint [not null]
  sha256 char(64) [not null]
  status varchar(16) [not null, note: 'draft | issued | executed | superseded']
  issued_at timestamp
  created_at timestamp
  updated_at timestamp
  indexes {
    (contract_id, document_type, version_number) [unique]
  }
  Note: '[NEW] Versioned private media; replacing a document invalidates old pending signatures, never old evidence.'
}

// [NEW] contract_signatures
Table contract_signatures [headercolor: #dcfce7] {
  id bigint [pk, increment]
  document_id bigint [not null]
  signer_user_id bigint [not null]
  party varchar(16) [not null, note: 'qader | client | talent']
  status varchar(16) [not null, note: 'pending | signed | declined']
  signed_at timestamp
  signature_method varchar(32)
  evidence_media_id bigint
  provider_reference varchar(255)
  created_at timestamp
  updated_at timestamp
  indexes {
    (document_id, signer_user_id, party) [unique]
  }
  Note: '[NEW] Signature acknowledgment tied to exact document version/hash. No particular e-signature provider assumed.'
}

// [NEW] engagements
Table engagements [headercolor: #dcfce7] {
  id bigint [pk, increment]
  contract_id bigint [not null, unique]
  status varchar(32) [not null, note: 'waiting_to_start | active | on_hold | ended | cancelled']
  actual_start_date date
  actual_end_date date
  end_reason text
  created_at timestamp
  updated_at timestamp
  Note: '[NEW] Hired Talents and waiting-to-start, 3621:28756/3649:29356/4310:66763. Hiring a talent is not workspace membership.'
}

// [DEFERRED] workspace_service_provisions
Table workspace_service_provisions [headercolor: #e5e7eb] {
