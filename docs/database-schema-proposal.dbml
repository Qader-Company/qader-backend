}

// [KEEP] sessions
Table sessions [headercolor: #dbeafe] {
  id varchar(255) [pk]
  user_id bigint
  ip_address varchar(45)
  user_agent text
  payload longtext [not null]
  last_activity int [not null]
  indexes {
    user_id
    last_activity
  }
  Note: '[KEEP] Existing user_id is indexed but not constrained by a physical FK.'
}

// [NEW/S00] user_devices
Table user_devices [headercolor: #dcfce7] {
  id bigint [pk, increment]
  user_id bigint [not null]
  platform varchar(20) [not null, note: 'web | ios | android']
  fcm_token text [not null, note: 'Encrypted at rest']
  fcm_token_hash char(64) [not null, unique, note: 'SHA-256 lookup/deduplication key']
  created_at timestamp
  updated_at timestamp
  indexes {
    (user_id, platform)
  }
  Note: '[NEW] S00. Created only when a successful login includes fcm_token. No separate device-registration endpoint.'
}

// [CHANGE/S00] personal_access_tokens
Table personal_access_tokens [headercolor: #fef3c7] {
  id bigint [pk, increment]
  tokenable_type varchar(255) [not null]
  tokenable_id bigint [not null]
  token_family_id char(36)
  user_device_id bigint
  name text [not null]
  token char(64) [not null, unique]
  abilities text
  last_used_at timestamp
  expires_at timestamp
  created_at timestamp
  updated_at timestamp
  indexes {
    (tokenable_type, tokenable_id)
    expires_at
  }
  Note: '[CHANGE] S00. Access and refresh tokens issued together share token_family_id. user_device_id is nullable when login has no FCM token.'
}

// [KEEP] api_keys
Table api_keys [headercolor: #dbeafe] {
  id int [pk, increment]
  name varchar(255) [not null]
  key varchar(64) [not null]
  active boolean [not null, default: true]
  deleted_at timestamp
  created_at timestamp
  updated_at timestamp
  indexes {
    name
    key
  }
  Note: '[KEEP] Existing API integration keys; int IDs, not bigint.'
}

// [KEEP] api_key_access_events
Table api_key_access_events [headercolor: #dbeafe] {
  id int [pk, increment]
  api_key_id int [not null]
  ip_address varchar(45) [not null]
  url text [not null]
  created_at timestamp
  updated_at timestamp
  Note: '[KEEP] Existing technical audit, not business workflow history.'
}

// [KEEP] api_key_admin_events
Table api_key_admin_events [headercolor: #dbeafe] {
  id int [pk, increment]
  api_key_id int [not null]
  ip_address varchar(45) [not null]
  event varchar(255) [not null]
  created_at timestamp
  updated_at timestamp
  indexes {
    event
  }
  Note: '[KEEP] Existing technical audit, not business workflow history.'
}

// [KEEP] cache
Table cache [headercolor: #dbeafe] {
  key varchar(255) [pk]
  value mediumtext [not null]
  expiration bigint [not null]
  indexes {
    expiration
  }
  Note: '[KEEP] Existing Laravel cache.'
}

// [KEEP] cache_locks
Table cache_locks [headercolor: #dbeafe] {
  key varchar(255) [pk]
  owner varchar(255) [not null]
  expiration bigint [not null]
  indexes {
    expiration
  }
  Note: '[KEEP] Existing Laravel cache lock.'
}

// [KEEP] jobs
Table jobs [headercolor: #dbeafe] {
  id bigint [pk, increment]
  queue varchar(255) [not null]
  payload longtext [not null]
  attempts smallint [not null]
  reserved_at int
  available_at int [not null]
  created_at int [not null]
  indexes {
    queue
  }
  Note: '[KEEP] Existing Laravel queue jobs. Business vacancies use job_postings.'
}

// [KEEP] job_batches
Table job_batches [headercolor: #dbeafe] {
  id varchar(255) [pk]
  name varchar(255) [not null]
  total_jobs int [not null]
  pending_jobs int [not null]
  failed_jobs int [not null]
  failed_job_ids longtext [not null]
  options mediumtext
  cancelled_at int
  created_at int [not null]
  finished_at int
  Note: '[KEEP] Existing Laravel batches.'
}

// [KEEP] failed_jobs
Table failed_jobs [headercolor: #dbeafe] {
  id bigint [pk, increment]
  uuid varchar(255) [not null, unique]
  connection text [not null]
  queue text [not null]
  payload longtext [not null]
  exception longtext [not null]
  failed_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  indexes {
    (connection, queue, failed_at)
  }
  Note: '[KEEP] Existing Laravel failed jobs.'
}

