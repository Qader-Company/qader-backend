APP_NAME=Qader
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://api.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
LOG_CHANNEL=stderr
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=qader
DB_USERNAME=qader
DB_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME_TOO
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SETTINGS_CACHE_ENABLED=true
SETTINGS_CACHE_MEMO=true
SESSION_DRIVER=database
FILESYSTEM_DISK=public
BROADCAST_CONNECTION=log
FIREBASE_CREDENTIALS=/var/www/html/storage/app/private/firebase/firebase-service-account.json
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GEMINI_API_KEY=
GEMINI_RESUME_PARSER_MODEL=gemini-3.8-flash
GEMINI_RESUME_PARSER_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_RESUME_PARSER_TIMEOUT=90
RATE_LIMIT_HIRING_SUPPORT_REQUESTS=5
RATE_LIMIT_HIRING_SUPPORT_REQUESTS_DECAY=60
PAYMENT_GATEWAY=
PAYMENT_FAKE_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_RATE_LIMIT=120
